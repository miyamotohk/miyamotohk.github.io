  year      = {2019},
  pages     = {1612-1616},
  location  = {Paris, France},
  doi       = {10.1109/ISIT.2019.8849464},
  abstract  = {We present a new approach to construct spherical codes in \(2^k\)~dimensions, based on Hopf foliations. Using the fact that a sphere \(S^\{2n-1\}\)~is foliated by manifolds \(S^\{n-1\}_\{\cos\eta\} \times S^\{n-1\}_\{\sin\eta\}\),~\(\eta\in\left[0,\pi/2\right]\), we distribute points in dimension \(2^k\)~via a recursive algorithm from a basic construction in~\(\mathbb\{R\}^4\). Our procedure outperforms some current constructive methods in several small-distance regimes and constitutes a compromise between optimality and computational effort.},
}

